-- 1. Overall business performance
SELECT
    COUNT(DISTINCT Order_ID) AS total_orders,
    SUM(Quantity) AS units_sold,
    ROUND(SUM(Revenue_INR), 2) AS total_revenue,
    ROUND(SUM(Profit_INR), 2) AS total_profit,
    ROUND(
        100 * SUM(Profit_INR) / NULLIF(SUM(Revenue_INR), 0),
        2
    ) AS profit_margin_pct
FROM retail_orders;

-- 2. Performance by product category
SELECT
    Category,
    ROUND(SUM(Revenue_INR), 2) AS revenue,
    ROUND(SUM(Profit_INR), 2) AS profit
FROM retail_orders
GROUP BY Category
ORDER BY revenue DESC;

-- 3. Monthly revenue trend
SELECT
    DATE_FORMAT(Order_Date, '%Y-%m') AS order_month,
    ROUND(SUM(Revenue_INR), 2) AS revenue,
    ROUND(SUM(Profit_INR), 2) AS profit
FROM retail_orders
GROUP BY DATE_FORMAT(Order_Date, '%Y-%m')
ORDER BY order_month;

-- 4. Compare sales channels
SELECT
    Sales_Channel,
    ROUND(SUM(Revenue_INR), 2) AS revenue,
    ROUND(SUM(Profit_INR), 2) AS profit
FROM retail_orders
GROUP BY Sales_Channel
ORDER BY profit DESC;

-- 5. Analyse discount levels
SELECT
    Discount_Pct,
    ROUND(SUM(Revenue_INR), 2) AS revenue,
    ROUND(SUM(Profit_INR), 2) AS profit
FROM retail_orders
GROUP BY Discount_Pct
ORDER BY Discount_Pct;
